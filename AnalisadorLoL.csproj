<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AnalisadorLoL</AssemblyName>
    <RootNamespace>AnalisadorLoL</RootNamespace>
    <Product>Analisador LoL</Product>
    <Version>1.2.1</Version>
    <Authors>Guilherme Silvestrini</Authors>
    <Company>Guilherme Silvestrini</Company>
    <Copyright>© 2026 Guilherme Silvestrini</Copyright>
    <Description>Analisador LoL — criado por Guilherme Silvestrini (github.com/devsilvver)</Description>
    <ApplicationIcon>assets/icone.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
    <!-- Leveza: GC de estação de trabalho, sem thread concorrente e heap adaptativo -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <GarbageCollectionAdaptationMode>1</GarbageCollectionAdaptationMode>
    <TieredPGO>true</TieredPGO>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <DebugType>embedded</DebugType>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\*" LogicalName="www/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>
</Project>
